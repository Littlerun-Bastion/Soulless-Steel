
# Godot-specific ignores
.import/
project/.godot/
export.cfg
export_presets.cfg

# Mono-specific ignores
.mono/
data_*/

# Local Godot editor binaries (kept next to the repo for running headless tests)
Godot_v*.exe

# The Godot editor copies GDExtension libraries (the git plugin) to
# ~<name>.dll while it runs on Windows; those copies change every session.
~*.dll*
