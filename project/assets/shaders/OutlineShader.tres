[gd_resource type="ShaderMaterial" format=3 uid="uid://co3srpqmbis5b"]

[sub_resource type="Shader" id="1"]
code = "shader_type canvas_item;
render_mode light_only;

uniform vec4 color : source_color = vec4(1.0);
uniform float width : hint_range(0, 100) = 1.0;
uniform float margin_distance : hint_range(0, 100.0) = 0.0;

const vec4 MASK_COLOR = vec4(1.0, 0.0, 0.84, 1.0);

void vertex() {
	VERTEX += (UV * (2.0 + margin_distance) - (1.0 + margin_distance/2.0)) * width;
}

void fragment() {
	vec2 uv = UV;
	
	vec2 texture_pixel_size = vec2(1.0) / (vec2(1.0) / TEXTURE_PIXEL_SIZE + vec2(width * 2.0));
	
	uv = (uv - texture_pixel_size * width) * TEXTURE_PIXEL_SIZE / texture_pixel_size;
	
	if (uv != clamp(uv, vec2(0.0), vec2(1.0))) {
		COLOR.a = 0.0;
	} else {
		COLOR = texture(TEXTURE, uv);
	}
	
	// An empty pixel within width texels of an opaque one is on the outline.
	// The search stays in fragment(): handing TEXTURE to a function of its
	// own makes Godot's headless shader compiler print an error.
	if (COLOR.a <= 0.0) {
		bool neighbour = false;
		for (float i = -ceil(width); i <= ceil(width) && !neighbour; i++) {
			float x = abs(i) > width ? width * sign(i) : i;
			for (float j = -ceil(width); j <= ceil(width); j++) {
				float y = abs(j) > width ? width * sign(j) : j;
				vec2 xy = uv + TEXTURE_PIXEL_SIZE * vec2(x, y);
				if (!(xy != clamp(xy, vec2(0.0), vec2(1.0)) || texture(TEXTURE, xy).a == 0.0)) {
					neighbour = true;
					break;
				}
			}
		}
		if (neighbour) {
			COLOR.rgb = MASK_COLOR.rgb;
			COLOR.a += (1.0 - COLOR.a) * color.a;
		}
	}
	
	if (COLOR == MASK_COLOR) {
		COLOR = color;
	} else {
		COLOR.a = 0.0;
	}
}"

[resource]
shader = SubResource("1")
shader_parameter/color = Color(1, 1, 1, 1)
shader_parameter/width = 6.0
shader_parameter/margin_distance = 3.0
