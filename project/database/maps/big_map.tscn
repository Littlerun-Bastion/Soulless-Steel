; TEST: loot container next to the player spawn (Pos1 at 0,0) for trying the
; container -> cargo drag flow. Press G next to it. Holds both test items
; (2x2 head, 1x3 weapon) plus 4 random salvage rolls from wreck_salvage, so
; tiers can be eyeballed. Remove once wrecks provide real loot.
[node name="TestLootContainer" parent="Props" instance=ExtResource("4_loot")]
position = Vector2(700, 0)
scale = Vector2(0.5, 0.5)
default_contents = Array[ExtResource("5_lootentry")]([ExtResource("6_testtable"), SubResource("LootEntry_TestItem")])
grid_width = 6
grid_height = 6
