; The prop sprite layers draw the spawn points of the PropSpawner in
; helwan_master.tscn (three levels up once this scene is instanced there).
; Parked and abandoned vehicles, at ground level (below mechas and roofs).
; Wrecks use the car sprites, drawn darker.
[node name="Vehicles" type="Node2D" parent="."]
script = ExtResource("sprite_layer")
spawner_path = NodePath("../../../PropSpawner")
kinds = PackedStringArray("vehicle_wreck", "vehicle", "truck", "bus", "military", "container", "railcar")
textures = {"vehicle_wreck": [ExtResource("spr_vehicle_ambulance"), ExtResource("spr_vehicle_estate"), ExtResource("spr_vehicle_hatchback"), ExtResource("spr_vehicle_pickup"), ExtResource("spr_vehicle_sports"), ExtResource("spr_vehicle_suv")], "vehicle": [ExtResource("spr_vehicle_ambulance"), ExtResource("spr_vehicle_estate"), ExtResource("spr_vehicle_hatchback"), ExtResource("spr_vehicle_pickup"), ExtResource("spr_vehicle_sports"), ExtResource("spr_vehicle_suv")], "truck": [ExtResource("spr_vehicle_container_truck"), ExtResource("spr_vehicle_dump_truck"), ExtResource("spr_vehicle_fire_engine"), ExtResource("spr_vehicle_minibus"), ExtResource("spr_vehicle_tanker")], "bus": [ExtResource("spr_vehicle_bus_city"), ExtResource("spr_vehicle_bus_coach")], "military": [ExtResource("spr_vehicle_apc"), ExtResource("spr_vehicle_military_truck"), ExtResource("spr_vehicle_tank_east"), ExtResource("spr_vehicle_tank_west")], "container": [ExtResource("spr_vehicle_container_20ft_a"), ExtResource("spr_vehicle_container_20ft_b"), ExtResource("spr_vehicle_container_40ft")], "railcar": [ExtResource("spr_vehicle_boxcar"), ExtResource("spr_vehicle_flatcar"), ExtResource("spr_vehicle_flatcar_container"), ExtResource("spr_vehicle_hopper"), ExtResource("spr_vehicle_metro_cab"), ExtResource("spr_vehicle_metro_car")]}
spans = {"vehicle_wreck": PackedFloat32Array(1.0, 0.99, 1.0, 1.0, 1.0, 1.0), "vehicle": PackedFloat32Array(1.0, 0.99, 1.0, 1.0, 1.0, 1.0), "truck": PackedFloat32Array(0.957, 0.914, 1.0, 1.0, 0.921), "bus": PackedFloat32Array(0.941, 0.942), "military": PackedFloat32Array(0.899, 0.915, 0.927, 0.929), "container": PackedFloat32Array(0.953, 0.953, 0.968), "railcar": PackedFloat32Array(0.97, 0.97, 0.97, 0.966, 0.979, 0.979)}
shadow_heights = {"vehicle_wreck": PackedFloat32Array(2.6, 1.5, 1.45, 1.8, 1.25, 1.75), "vehicle": PackedFloat32Array(2.6, 1.5, 1.45, 1.8, 1.25, 1.75), "truck": PackedFloat32Array(4.0, 3.2, 3.0, 2.4, 3.5), "bus": PackedFloat32Array(3.0, 3.5), "military": PackedFloat32Array(2.4, 3.0, 2.3, 2.4), "container": PackedFloat32Array(2.6, 2.6, 2.6), "railcar": PackedFloat32Array(4.0, 1.3, 3.9, 3.8, 3.6, 3.6)}
tones = {"vehicle_wreck": 0.55}
tone_jitter = 0.15

; Gives the vehicles bodies: mechas push them, and they stop shots by chance
; (see VehicleField and MapSenses). Mass and shot_block come per sprite from
; sprite_catalogue.json.
[node name="VehicleField" type="Node2D" parent="."]
