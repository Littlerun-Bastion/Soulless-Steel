masses = {"vehicle_wreck": PackedFloat32Array(3500.0, 1500.0, 950.0, 2000.0, 1300.0, 2200.0), "vehicle": PackedFloat32Array(3500.0, 1500.0, 950.0, 2000.0, 1300.0, 2200.0), "truck": PackedFloat32Array(15000.0, 20000.0, 14000.0, 4200.0, 22000.0), "bus": PackedFloat32Array(12000.0, 13000.0), "military": PackedFloat32Array(14000.0, 9000.0, 45000.0, 60000.0), "container": PackedFloat32Array(25000.0, 25000.0, 30000.0)}
