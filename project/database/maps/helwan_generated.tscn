; The prop sprite layers draw the spawn points of the PropSpawner in
; helwan_master.tscn (three levels up once this scene is instanced there).
; Parked and abandoned vehicles, at ground level (below mechas and roofs).
; Wrecks use the car sprites, drawn darker.
[node name="Vehicles" type="Node2D" parent="."]
script = ExtResource("sprite_layer")
spawner_path = NodePath("../../../PropSpawner")
kinds = PackedStringArray("vehicle_wreck", "vehicle", "truck")
textures = {"vehicle_wreck": [ExtResource("spr_vehicle_ambulance"), ExtResource("spr_vehicle_estate"), ExtResource("spr_vehicle_hatchback"), ExtResource("spr_vehicle_pickup"), ExtResource("spr_vehicle_sports"), ExtResource("spr_vehicle_suv")], "vehicle": [ExtResource("spr_vehicle_ambulance"), ExtResource("spr_vehicle_estate"), ExtResource("spr_vehicle_hatchback"), ExtResource("spr_vehicle_pickup"), ExtResource("spr_vehicle_sports"), ExtResource("spr_vehicle_suv")], "truck": [ExtResource("spr_vehicle_fire_engine"), ExtResource("spr_vehicle_minibus")]}
spans = {"vehicle_wreck": PackedFloat32Array(1.0, 0.99, 1.0, 1.0, 1.0, 1.0), "vehicle": PackedFloat32Array(1.0, 0.99, 1.0, 1.0, 1.0, 1.0), "truck": PackedFloat32Array(1.0, 1.0)}
tones = {"vehicle_wreck": 0.55}
tone_jitter = 0.15

; Gives the vehicles bodies: mechas push them, and they stop shots by chance
; (see VehicleField and MapSenses). Mass and shot_block come per sprite from
; sprite_catalogue.json.
[node name="VehicleField" type="Node2D" parent="."]
script = ExtResource("vehicle_field")
spawner_path = NodePath("../../../PropSpawner")
layer_path = NodePath("../Vehicles")
kinds = PackedStringArray("vehicle_wreck", "vehicle", "truck")
masses = {"vehicle_wreck": PackedFloat32Array(3500.0, 1500.0, 950.0, 2000.0, 1300.0, 2200.0), "vehicle": PackedFloat32Array(3500.0, 1500.0, 950.0, 2000.0, 1300.0, 2200.0), "truck": PackedFloat32Array(14000.0, 4200.0)}
shot_blocks = {"vehicle_wreck": PackedFloat32Array(0.65, 0.5, 0.5, 0.55, 0.5, 0.55), "vehicle": PackedFloat32Array(0.65, 0.5, 0.5, 0.55, 0.5, 0.55), "truck": PackedFloat32Array(0.85, 0.7)}

; Trees and bushes, above mechas. Each tree is 2-3 bare branch slices
; stacked. Plants near the player fade; they also hide what is under them
; from detection (see MapSenses).
[node name="Foliage" type="Node2D" parent="."]
z_index = 2
script = ExtResource("sprite_layer")
spawner_path = NodePath("../../../PropSpawner")
kinds = PackedStringArray("bush", "tree")
textures = {"bush": [ExtResource("spr_bush_1"), ExtResource("spr_bush_2"), ExtResource("spr_bush_3"), ExtResource("spr_bush_4"), ExtResource("spr_bush_5"), ExtResource("spr_bush_6")], "tree": [ExtResource("spr_tree_1"), ExtResource("spr_tree_2"), ExtResource("spr_tree_3"), ExtResource("spr_tree_4")]}
spans = {"bush": PackedFloat32Array(0.666, 0.707, 0.678, 0.781, 0.697, 0.912), "tree": PackedFloat32Array(0.907, 0.964, 0.94, 0.945)}
layers = {"tree": Vector2i(2, 3)}
tones = {"tree": 0.85, "bush": 0.6}
fade_near_player = true
conceals = true

; Makes the generated buildings enterable, gives them walls that stop shots
; and block sight, and fades the roofs round the player.
[node name="BuildingField" type="Node2D" parent="."]
script = ExtResource("field")
footprints = ExtResource("footprints")
roof_material = SubResource("Mat_roofs")

; Elevated structures from OpenStreetMap, above mechas, foliage and roofs.
[node name="Overheads" type="Node2D" parent="."]
z_index = 3

[node name="Viaduct1" type="Line2D" parent="Overheads"]
points = PackedVector2Array(25000, 14258, 22194, 13008, 19752, 11996, 7643, 7188, -2217, 3201, -9307, 1276, -12351, 792, -14527, 528, -15983, 426, -17576, 348, -19101, 315, -20146, 328, -22040, 463, -25000, 718)
width = 200.0
script = ExtResource("overhead")
