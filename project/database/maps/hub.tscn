; The Hub is one 4000x4000 chunk centred on the origin (corners at ±2000).
; Ground sits at the top-left corner because its polygon runs from (0, 0) to map_size.
[node name="BG" type="Node2D" parent="."]

[node name="Ground" type="Polygon2D" parent="BG"]
