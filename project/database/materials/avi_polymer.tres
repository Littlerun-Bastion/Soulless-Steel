[gd_resource type="Resource" script_class="MaterialData" load_steps=2 format=3]

[ext_resource type="Script" path="res://database/materials/MaterialData.gd" id="1_material"]

[resource]
script = ExtResource("1_material")
id = "avi_polymer"
display_name = "AVI-Polymer"
origin = 1
unit = "g"
display_unit = "kg"
kg_per_unit = 0.001
value = 0.006
description = "The base matter of Entities. An Entity uses it to fuse to objects and take on their structure and material. Entity residue, mote clusters and Fisher hearts and shells break into it. The Fabricator can fill any other shortfall with it, at a poor rate. Nordomeccanica, Wu-Zhi and the specialist wetware makers need it directly."
