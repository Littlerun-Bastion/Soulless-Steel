[resource]
script = ExtResource("1_material")
id = "avidendrites"
display_name = "Avidendrites"
origin = 1
unit = "kg"
display_unit = "kg"
kg_per_unit = 1.0
value = 33.0
description = "An AVIS-synthesised substance that behaves like neural biomatter, with a responsiveness and capacitance far beyond it. In a SAV it is grown into the pilot's interface: the only workable source is a dead pilot's capsule. Cores, heads and chipsets above civ grade need 2 to 5 kg."
