[gd_resource type="Resource" script_class="MaterialData" load_steps=2 format=3]

[ext_resource type="Script" path="res://database/materials/MaterialData.gd" id="1_material"]

[resource]
script = ExtResource("1_material")
id = "copper"
display_name = "Copper"
unit = "kg"
display_unit = "t"
kg_per_unit = 1.0
value = 0.03
description = "Found in every electronic device, copper is the most important component to facilitate any kind of electronic circuit, and is used as an electrical conductor and as a thermal conductor. Wiring, motors, transformers, cable drums and brass cases break into it. Used in generators, actuators and energy weapons, and in nearly every SAV part."
