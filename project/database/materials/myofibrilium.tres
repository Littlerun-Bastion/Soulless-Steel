[gd_resource type="Resource" script_class="MaterialData" load_steps=2 format=3]

[ext_resource type="Script" path="res://database/materials/MaterialData.gd" id="1_material"]

[resource]
script = ExtResource("1_material")
id = "myofibrilium"
display_name = "Myofibrilium"
origin = 1
unit = "g"
display_unit = "kg"
kg_per_unit = 0.001
value = 0.02
description = "The glue and muscle that holds an Entity's AVI-Polymer together. Extraordinarily tough, lightweight and flexible, it contracts or expands with the electrical signals it receives, like biological muscle. Entities hold small amounts; the actuator bundles of higher-tech SAVs hold more. Used in the actuators of higher-tech SAV parts."
