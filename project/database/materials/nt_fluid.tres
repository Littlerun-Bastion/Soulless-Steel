[gd_resource type="Resource" script_class="MaterialData" load_steps=2 format=3]

[ext_resource type="Script" path="res://database/materials/MaterialData.gd" id="1_material"]

[resource]
script = ExtResource("1_material")
id = "nt_fluid"
display_name = "NT Fluid"
origin = 1
unit = "mL"
display_unit = "L"
kg_per_unit = 0.001
value = 0.003
description = "The 'blood' of Entities. Most Entities hold a little of it; SAVs that use it as coolant carry it in canisters. A vastly more efficient coolant than water-based solutions, used in military-grade weapons and SAV hardware. AVF coolant is made from it."
